{
  "version": 1,
  "rules": [
    {"id": "dependency-trees", "reason": "vendored dependencies", "globs": ["**/node_modules/**", "**/vendor/**"]},
    {"id": "vcs-internals", "reason": "version-control metadata", "globs": ["**/.git/**", "**/.svn/**"], "extensions": [".svn-base"]},
    {"id": "build-tool-cache", "reason": "build-tool cache files", "extensions": [".lastUpdated", ".repositories", ".sha1"]},
    {"id": "logs", "reason": "application and server logs", "extensions": [".log"], "globs": ["**/*.log.*"]},
    {"id": "rotated-copies", "reason": "rotated or numbered output copies (name.015185, name.2023-04-11)", "numbered_suffixes": true}
  ]
}
